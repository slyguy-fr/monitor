[Unit]
Description=Linux Task Monitor - API
After=network.target linux-task-monitor.service

[Service]
Type=simple
User=ltm
Group=ltm
WorkingDirectory=/opt/linux-task-monitor
Environment=LTM_DB_PATH=/var/lib/linux-task-monitor/monitor.db
Environment=LTM_API_HOST=192.168.0.129
Environment=LTM_API_PORT=8000
EnvironmentFile=-/etc/linux-task-monitor/monitor.env
ExecStart=/opt/linux-task-monitor/.venv/bin/python -m uvicorn api.main:app --host ${LTM_API_HOST} --port ${LTM_API_PORT}
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/linux-task-monitor
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
