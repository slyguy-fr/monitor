# Configuration de Linux Task Monitor (lue par l'agent et l'API).
# LTM_INTERVAL_SECONDS=15
# LTM_ANALYSIS_INTERVAL_SECONDS=60
# LTM_TASK_SAMPLES_RETENTION_HOURS=48
# LTM_SAMPLES_RETENTION_DAYS=30
# Seuils des détecteurs, ex. :
# LTM_THRESHOLD_TASK_CPU_PERCENT=90
# LTM_THRESHOLD_DISK_PERCENT=80

# API : écoute locale par défaut. Si vous l'exposez, définissez un jeton.
# LTM_API_HOST=127.0.0.1
# LTM_API_PORT=8000
# LTM_API_TOKEN=
