# Configuration de Linux Task Monitor (lue par l'agent et l'API).
# LTM_INTERVAL_SECONDS=15
# LTM_ANALYSIS_INTERVAL_SECONDS=60
# LTM_TASK_SAMPLES_RETENTION_HOURS=48
# LTM_SAMPLES_RETENTION_DAYS=30
# Seuils des détecteurs, ex. :
# LTM_THRESHOLD_TASK_CPU_PERCENT=90
# LTM_THRESHOLD_DISK_PERCENT=80

# API : écoute locale par défaut. Si vous l'exposez, définissez un jeton.
# LTM_API_HOST=127.0.0.1
# LTM_API_PORT=8000
# LTM_API_TOKEN=

# Résumé IA (désactivé si LTM_LLM_MODEL est vide). API compatible OpenAI :
# OpenAI, Azure OpenAI, Mistral, Groq, OpenRouter, Ollama (http://127.0.0.1:11434/v1)…
# Les problèmes (titres, preuves, extraits de diagnostics, secrets masqués) sont envoyés au fournisseur.
# LTM_LLM_MODEL=gpt-4o-mini
# LTM_LLM_API_KEY=
# LTM_LLM_BASE_URL=https://api.openai.com/v1
# LTM_LLM_MIN_INTERVAL_SECONDS=600
